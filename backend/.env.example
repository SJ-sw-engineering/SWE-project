# Run: python -m scripts.init_env
# Edit the generated .env with your own MySQL connection details.
APP_NAME=Recruitment API
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=recruitment_db
DB_USER=recruitment_app
DB_PASSWORD=
# init_env generates a random key. Never commit .env.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:5173"]
